# ---- Client-safe (exposed to the browser; MUST use NEXT_PUBLIC_ prefix) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Server-only secrets (NO NEXT_PUBLIC_ prefix; never sent to the browser) ----
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
INGEST_DEVICE_KEY_SALT=

# Notes:
# - Copy this file to .env.local and fill in values for a real Supabase project.
# - The app builds and runs WITHOUT any of these set (it shows demo/mock data).
# - Only NEXT_PUBLIC_* values are safe to expose in the client bundle.
