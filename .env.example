# ============================================================================
#  ESP32CAM-Guard 환경변수 템플릿 (키 이름만 — 실제 값은 .env.local / Vercel 환경변수)
#  ⚠️ 실제 값이 담긴 .env.local 은 커밋 금지 (.gitignore 대상)
# ============================================================================

# ─── 웹 대시보드 (web/.env.local 로 복사) ───────────────────────────────────
# 클라이언트 노출 값만 NEXT_PUBLIC_ 접두사
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 비밀값 (접두사 없음, 클라이언트 번들 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=          # 서버측 MP4 변환/재전송용(선택)
INGEST_DEVICE_KEY_SALT=      # device_key 해시 솔트(선택)

# ─── 펌웨어 비밀값은 여기 두지 않는다 ───────────────────────────────────────
# 텔레그램 토큰/chat_id/device_key 는 firmware/esp32cam_guard/secrets.h (커밋 X)
# 또는 캡티브 포털 입력 → NVS 저장(정식 경로). PRD FR-5.0.5 참조.
